datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  USER
  ADMIN
}

enum ShortlistCategory {
  DREAM
  TARGET
  SAFE
}

model User {
  id            String         @id @default(cuid())
  name          String?
  email         String?        @unique
  emailVerified DateTime?
  image         String?
  password      String?        // Encrypted credentials password
  role          Role           @default(USER)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  // NextAuth Session management relations
  accounts      Account[]
  sessions      Session[]

  // Platform relations
  savedColleges SavedCollege[]
  reviews       Review[]
  
  // CampusCompass relations
  searchHistory     SearchHistory[]
  comparisonHistory ComparisonHistory[]
  predictions       CollegePrediction[]
  preference        UserPreference?
}

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model College {
  id              String          @id @default(cuid())
  slug            String          @unique
  name            String
  description     String          @db.Text
  city            String
  state           String
  country         String          @default("USA")
  tuitionInState  Int
  tuitionOutState Int
  admissionRate   Float           // Value between 0.0 and 1.0 (e.g. 0.08 = 8%)
  graduationRate  Float           // Value between 0.0 and 1.0 (e.g. 0.88 = 88%)
  imageUrl        String?
  logoUrl         String?
  websiteUrl      String?
  
  // Predictor and Admissions requirements
  satReadingMin   Int?
  satReadingMax   Int?
  satMathMin      Int?
  satMathMax      Int?
  actCompositeMin Int?
  actCompositeMax Int?
  medianSalary    Int?            // Graduate placement earnings

  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  // Platform relations
  savedBy         SavedCollege[]
  reviews         Review[]
  courses         CollegeCourse[]
  
  // CampusCompass relations
  predictions     CollegePrediction[]
  comparisonItems ComparisonCollege[]

  // Indexes for high performance filtering and sorting
  @@index([state])
  @@index([tuitionOutState])
  @@index([admissionRate])
}

model Course {
  id          String          @id @default(cuid())
  code        String          @unique // e.g. "CS-101", "MECH-202"
  name        String          @unique // e.g. "Introduction to Computer Science"
  category    String          // e.g. "Computer Science", "Engineering", "Business"
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  // Platform relations
  colleges    CollegeCourse[]

  // Index for category-based filtering
  @@index([category])
}

// Explicit Join Table for Many-to-Many relationship between College and Course
model CollegeCourse {
  collegeId String
  courseId  String
  college   College @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  course    Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@id([collegeId, courseId])
  @@index([collegeId])
  @@index([courseId])
}

model Review {
  id        String   @id @default(cuid())
  userId    String
  collegeId String
  rating    Int      // 1 to 5 stars
  content   String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  college   College  @relation(fields: [collegeId], references: [id], onDelete: Cascade)

  // A user can submit only one review per college
  @@unique([userId, collegeId])
  @@index([collegeId])
  @@index([userId])
}

model SavedCollege {
  id        String            @id @default(cuid())
  userId    String
  collegeId String
  notes     String?           @db.Text // Custom user notes/checklist updates
  category  ShortlistCategory @default(TARGET)
  createdAt DateTime          @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  college   College  @relation(fields: [collegeId], references: [id], onDelete: Cascade)

  // A user can save a specific college only once
  @@unique([userId, collegeId])
  @@index([userId])
  @@index([collegeId])
}

model SearchHistory {
  id        String   @id @default(cuid())
  userId    String
  query     String
  filters   String?  // Store active filtering tags as JSON string
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model ComparisonHistory {
  id         String              @id @default(cuid())
  userId     String
  createdAt  DateTime            @default(now())

  user       User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  colleges   ComparisonCollege[]

  @@index([userId])
}

model ComparisonCollege {
  comparisonId String
  collegeId    String
  comparison   ComparisonHistory @relation(fields: [comparisonId], references: [id], onDelete: Cascade)
  college      College           @relation(fields: [collegeId], references: [id], onDelete: Cascade)

  @@id([comparisonId, collegeId])
  @@index([comparisonId])
  @@index([collegeId])
}

model UserPreference {
  id              String   @id @default(cuid())
  userId          String   @unique
  preferredState  String?
  preferredCourse String?
  budgetMax       Int?
  examType        String?  // "SAT" or "ACT"
  examScore       Int?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model CollegePrediction {
  id          String   @id @default(cuid())
  userId      String
  collegeId   String
  matchScore  Int      // 0 to 100 percentage
  explanation String   @db.Text
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  college     College  @relation(fields: [collegeId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([collegeId])
}
