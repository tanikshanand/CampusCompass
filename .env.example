# =========================================================================
# CampusCompass – Environment Variables Template
# Copy this file to '.env' and fill in your values.
# =========================================================================

# NextAuth Configuration
# For local development: http://localhost:3000
# For production: Your Vercel / deployment custom domain URL
NEXTAUTH_URL="http://localhost:3000"

# Generate a secure random key. 
# Command to generate: openssl rand -base64 32
NEXTAUTH_SECRET="your-super-secure-nextauth-secret-key-goes-here"

# -------------------------------------------------------------------------
# DATABASE CONFIGURATIONS
# -------------------------------------------------------------------------

# Option A: Local Development Fallback (SQLite)
# To use SQLite, set the URL below, generate the client using:
#   npm run db:generate:sqlite
# And push the schema using:
#   npm run db:push:sqlite
DATABASE_URL="file:./dev.db"

# Option B: Production Database (PostgreSQL / Neon)
# To use PostgreSQL, set the URL below, generate the client using:
#   npm run db:generate:pg
# And deploy migrations using:
#   npm run db:migrate:pg
# Example Neon Connection String:
# DATABASE_URL="postgresql://neondb_owner:password@ep-cool-snowflake-a5t2zdb3.us-east-2.aws.neon.tech/campuscompass?sslmode=require"
